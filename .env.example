# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=            # generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=0          # 1 enables the debugger and auto-reload. Local development only.
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Slack
SLACK_WEBHOOK_URL=

# Jira
JIRA_DOMAIN=wavelynx.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Google Cloud Storage
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
# Optional. Leave unset to use your gcloud application-default login.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Forge (IAP cookie copied from a signed-in browser session)
FORGE_BASE_URL=
ACTIVE_IAP_UID=
ACTIVE_IAP_COOKIE=

# PocketBase
PB_BASE_URL=
PB_COLLECTION_ID=cards
PB_ADMIN_TOKEN=

# INI generation (INI-Generator package). Needs settings_default.ini and customer_profiles.json.
# By default they're downloaded from gs://<GCS_BUCKET_NAME>/<INI_GENERATOR_GCS_PREFIX>.
# INI_GENERATOR_GCS_PREFIX=private/ini-generator/
# Or point at a local folder instead (e.g. your INI-Generator clone's private/ folder):
# INI_GENERATOR_PRIVATE_DIR=/Users/you/Desktop/INI-Generator/private

# OSDP flashing. Optional fallback when the RS-485 adapter isn't detected automatically.
# OSDP_SERIAL_PORT=/dev/tty.usbserial-XXXX
