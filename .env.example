# Copy to .env and fill in. Never commit .env.

# Flask
SECRET_KEY=            # generate with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_DEBUG=0          # 1 enables the debugger and auto-reload. Local development only.
LOG_LEVEL=INFO

# Sign-in. "dev" (the only mode so far) lets anyone act as any user: local use only.
# AUTH_MODE=dev
# SESSION_HOURS=12
# ALLOWED_EMAIL_DOMAIN=wavelynx.com

# Database
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME

# Slack
SLACK_WEBHOOK_URL=

# Jira
JIRA_DOMAIN=wavelynx.atlassian.net
JIRA_USER_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

# Google Cloud Storage
GCP_PROJECT_ID=
GCS_BUCKET_NAME=
# FORGE_FOLDER_EMAIL=jhepburn@wavelynx.com   # CALIGA writes to GCS only in forge/<this email>/, whoever is signed in
# Optional. Leave unset to use your gcloud application-default login.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Forge (IAP cookie copied from a signed-in browser session)
FORGE_BASE_URL=
ACTIVE_IAP_UID=
ACTIVE_IAP_COOKIE=

# PocketBase
PB_BASE_URL=
PB_COLLECTION_ID=cards
PB_ADMIN_TOKEN=

# INI generation (INI-Generator package). Required for generating INIs: the local folder with
# settings_default.ini and customer_profiles.json (e.g. your INI-Generator clone's private/ folder).
# These files are never stored in GCS.
INI_GENERATOR_PRIVATE_DIR=/Users/you/Desktop/INI-Generator/private

# Background jobs. Their files are stored in the database. CALIGA only writes to GCS inside forge/<FORGE_FOLDER_EMAIL>/.
# JOB_WORKERS=2                 # worker threads per web process (0 when a separate `flask run-worker` runs)
# JOB_WORKER_THREADS=4          # threads for `flask --app app run-worker`
